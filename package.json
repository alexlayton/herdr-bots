{
  "name": "herdr-bots",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:alexlayton/herdr-bots",
  "description": "Let coding agents in herdr panes message each other and delegate tasks (PoC)",
  "type": "module",
  "bin": {
    "bots": "src/cli.ts"
  },
  "scripts": {
    "daemon": "bun src/cli.ts daemon",
    "mcp": "bun src/cli.ts mcp",
    "build": "bun build src/cli.ts --compile --outfile bin/bots",
    "check": "bun build src/cli.ts --target=bun --outdir /tmp/bots-build"
  }
}
